#!/usr/bin/env bash
# ==============================================================================
# Git Hook: commit-msg (Validador de Formato Convencional y TASK-ID)
# ==============================================================================
# Formato exigido:
#   tipo(TASK-XXX): descripción en imperativo
# Ejemplos válidos:
#   feat(TASK-001): agregar endpoint de login con jwt
#   fix(TASK-002): corregir redondeo en calculo de totales
# ==============================================================================

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Permitir commits automáticos de merge o squash
if echo "$COMMIT_MSG" | grep -qE "^(Merge |Revert |fixup! |squash! )"; then
  exit 0
fi

# Patrón regex estricto
PATTERN="^(feat|fix|test|docs|refactor|perf|chore|style|build|ci)\((TASK-[0-9]+)\): .+$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ ERROR EN MENSAJE DE COMMIT:"
  echo "   El mensaje: \"$COMMIT_MSG\""
  echo "   no cumple la convención obligatoria del sistema multi-agente."
  echo ""
  echo "   Formato requerido:"
  echo "     tipo(TASK-XXX): descripción breve"
  echo ""
  echo "   Tipos permitidos: feat, fix, test, docs, refactor, perf, chore, style, build, ci"
  echo "   Ejemplo correcto:"
  echo "     feat(TASK-001): implementar autenticacion jwt"
  echo ""
  exit 1
fi

TASK_ID=$(echo "$COMMIT_MSG" | sed -E 's/^[a-z]+\((TASK-[0-9]+)\):.*/\1/')
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
STATE_FILE="$PROJECT_ROOT/GLOBAL_STATE.md"

if [ -f "$STATE_FILE" ]; then
  TASK_EXISTS=$(awk -F'|' -v tid="$TASK_ID" '
    /^\|/ {
      id = $2; gsub(/[ \t`]/, "", id)
      if (id == tid) { found = 1; exit }
    }
    END { print found + 0 }
  ' "$STATE_FILE")

  if [ "$TASK_EXISTS" -ne 1 ]; then
    echo ""
    echo "❌ ERROR EN MENSAJE DE COMMIT:"
    echo "   La tarea '$TASK_ID' no existe en el tablero de GLOBAL_STATE.md."
    echo "   Registra la tarea con /nueva-tarea o './.agents/scripts/task.sh add' antes de hacer commit."
    echo ""
    exit 1
  fi
fi

exit 0
