# ==============================================================================
# .gitignore Estándar para Ecosistemas Multi-Agente
# ==============================================================================

# Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Variables de Entorno y Secretos (PROHIBIDO SUBIR)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# Archivos de ejemplo permitidos
!.env.example
!.env.template

# Node.js y Gestores de Paquetes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Compilación y Salida de Builds
dist/
build/
out/
.next/
.nuxt/
.output/
.angular/
dist-ssr/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Bases de Datos Locales y Temporales
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# IDEs y Editores de Código
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Logs y Archivos Temporales
logs/
*.log
tmp/
temp/
*.tmp
coverage/
.nyc_output/
.agents/.task_lock/

# Reportes de prueba y capturas temporales
/test-results/
/playwright-report/
/blob-report/
docs/dashboard.html

# Claude Code (configuracion local por usuario)
.claude/settings.local.json
